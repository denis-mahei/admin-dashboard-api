generator client {
  provider        = "prisma-client"
  output          = "../generated/prisma"
  previewFeatures = ["strictUndefinedChecks"]
  moduleFormat    = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  CUSTOMER
}

model User {
  id        Int        @id @default(autoincrement())
  email     String     @unique
  name      String
  phone     String?
  password  String
  role      Role       @default(CUSTOMER)
  cartItems CartItem[]
}

model Supplier {
  id       Int       @id @default(autoincrement())
  name     String
  address  String
  company  String
  date     DateTime
  amount   Float
  status   String
  products Product[]
}

model Product {
  id         Int        @id @default(autoincrement())
  photo      String?
  name       String
  supplier   Supplier   @relation(fields: [supplierId], references: [id])
  stock      Int
  price      Float
  supplierId Int
  category   String
  cartItems  CartItem[]
}

model Customer {
  id            Int      @id @default(autoincrement())
  photo         String?
  name          String
  email         String
  spent         Float
  phone         String
  address       String
  register_date DateTime
}

model Order {
  id         Int      @id @default(autoincrement())
  photo      String?
  name       String
  address    String
  products   Int
  price      Float
  status     String
  order_date DateTime
}

model IncomeExpenses {
  id     Int    @id @default(autoincrement())
  name   String
  amount Float
  type   String
}

model Pharmacy {
  id      Int    @id @default(autoincrement())
  name    String
  address String
  city    String
  phone   String
  rating  Int
  type    String @default("regular")
}

model Review {
  id          Int    @id @default(autoincrement())
  name        String
  testimonial String
}

model CartItem {
  id        Int     @id @default(autoincrement())
  quantity  Int
  userId    Int
  user      User    @relation(fields: [userId], references: [id])
  productId Int
  product   Product @relation(fields: [productId], references: [id])
}
