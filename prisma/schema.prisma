// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int    @id @default(autoincrement())
  email    String @unique
  name     String
  password String
}

model Supplier {
  id       Int       @id @default(autoincrement())
  name     String
  address  String
  company  String
  date     DateTime
  amount   Decimal
  status   String
  products Product[]
}

model Product {
  id         Int      @id @default(autoincrement())
  photo      String
  name       String
  supplier   Supplier @relation(fields: [supplierId], references: [id])
  stock      Int
  price      Decimal
  supplierId Int
  category   String
}

model Customer {
  id            Int      @id @default(autoincrement())
  photo         String
  name          String
  email         String
  spent         Decimal
  phone         String
  address       String
  register_date DateTime
}

model Order {
  id       Int    @id @default(autoincrement())
  photo    String
  name     String
  address  String
  products
}
